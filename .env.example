# ShoeStore Production Environment Variables Example

# Application Environment ('development', 'testing', 'production')
FLASK_ENV=production

# Security - Replace with a strong 64-character secret key in production
SECRET_KEY=generate-a-strong-production-secret-key-here

# Database Configuration
# Local SQLite (default fallback): sqlite:///shoestore.db
# Production PostgreSQL example: postgresql://shoestore_user:password@localhost:5432/shoestore_db
DATABASE_URL=sqlite:///shoestore.db

# Server Binding Port (Render, Railway, Heroku automatically inject PORT)
PORT=5000
